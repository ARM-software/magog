# Default default behavior to Unix-style
* text=auto eol=lf

# Explicitly declare commonly used text and binary file types
*.bat text eol=crlf
*.c text
*.cpp text
*.css text
*.gpl text
*.ini text
*.java text
*.h text
*.hpp text
*.md text
*.py text
*.sh text
*.svg text
*.txt text
*.yaml text

*.jpg binary
*.png binary
*.webp binary
